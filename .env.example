# Required for every production build. Do not use the public Wix URL here.
SITE_URL=

# Required before connecting the new KULT360 Sanity project.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_APP_ID=

# Optional verified identity fields. Leave empty rather than inventing data.
PUBLIC_ORGANIZATION_LEGAL_NAME=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_ADDRESS=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_YOUTUBE=
PUBLIC_SOCIAL_LINKEDIN=

# Worker-only configuration. Configure before enabling contact delivery.
CONTACT_DESTINATION_EMAIL=
CONTACT_SENDER_EMAIL=
ALLOWED_ORIGINS=
