---
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import {organizationSchema, websiteSchema, webPageSchema} from '../lib/seo';
import type {BaseLayoutProps} from './types';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/utilities.css';
import '../styles/foundation-v2.css';
import '../styles/refinement-v3.css';
import '../styles/experience.css';

type Props = BaseLayoutProps;
const {title, description, language, path, translations = [language], noindex = false, about = false, schemas = []} = Astro.props;
const structuredData = [organizationSchema(), websiteSchema(), webPageSchema({title, description, path, language, about}), ...schemas];
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <SeoHead {title} {description} {language} {path} {translations} {noindex} />
    <StructuredData schemas={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{language === 'sq' ? 'Kalo te përmbajtja' : 'Skip to content'}</a>
    <Header {language} {path} {translations} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer {language} />
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const header = document.querySelector<HTMLElement>('.site-header');
      const pageProgress = document.querySelector<HTMLElement>('[data-page-progress]');

      const updatePageChrome = () => {
        const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollRange > 0 ? Math.min(1, window.scrollY / scrollRange) : 0;
        header?.classList.toggle('is-scrolled', window.scrollY > 24);
        pageProgress?.style.setProperty('--page-progress', String(progress));
      };

      let frame = 0;
      const requestChromeUpdate = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(() => {
          updatePageChrome();
          frame = 0;
        });
      };

      window.addEventListener('scroll', requestChromeUpdate, {passive: true});
      window.addEventListener('resize', requestChromeUpdate, {passive: true});
      updatePageChrome();

      const revealTargets = document.querySelectorAll<HTMLElement>([
        '.pcf-intro__grid > *',
        '.pcf-section-head > *',
        '.pcf-update-list > a',
        '.pcf-programme-card',
        '.pcf-project-card',
        '.pcf-signals__head > *',
        '.pcf-story-card',
        '.pcf-person-card',
        '.pcf-partners__grid > *',
        '.pcf-join .container-wide > *',
        '.program-detail__statement > *',
        '.program-detail__principle-grid > *',
        '.program-detail__project-grid > *'
      ].join(','));

      revealTargets.forEach((element, index) => {
        element.classList.add('motion-reveal');
        element.style.setProperty('--reveal-delay', `${(index % 4) * 55}ms`);
      });

      if (reducedMotion.matches || !('IntersectionObserver' in window)) {
        revealTargets.forEach((element) => element.classList.add('is-visible'));
      } else {
        document.documentElement.classList.add('has-reveal-motion');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, {rootMargin: '0px 0px -8% 0px', threshold: 0.08});
        revealTargets.forEach((element) => observer.observe(element));
      }

      document.querySelectorAll<HTMLElement>('[data-story-rail]').forEach((rail) => {
        const section = rail.closest<HTMLElement>('.pcf-signals');
        const controls = section?.querySelector<HTMLElement>('[data-story-controls]');
        const previous = controls?.querySelector<HTMLButtonElement>('[data-story-prev]');
        const next = controls?.querySelector<HTMLButtonElement>('[data-story-next]');
        const indicator = controls?.querySelector<HTMLElement>('[data-story-progress]');
        if (!controls || !previous || !next) return;

        rail.tabIndex = 0;
        const amount = () => Math.max(280, rail.clientWidth * 0.76);
        const updateRail = () => {
          const max = Math.max(0, rail.scrollWidth - rail.clientWidth);
          const progress = max ? Math.min(1, Math.max(0, rail.scrollLeft / max)) : 0;
          previous.disabled = rail.scrollLeft <= 2;
          next.disabled = rail.scrollLeft >= max - 2;
          indicator?.style.setProperty('--rail-progress', String(progress));
        };
        const move = (direction: number) => rail.scrollBy({
          left: direction * amount(),
          behavior: reducedMotion.matches ? 'auto' : 'smooth'
        });

        previous.addEventListener('click', () => move(-1));
        next.addEventListener('click', () => move(1));
        rail.addEventListener('scroll', updateRail, {passive: true});
        rail.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          move(event.key === 'ArrowLeft' ? -1 : 1);
        });
        new ResizeObserver(updateRail).observe(rail);

        if ('IntersectionObserver' in window) {
          const railObserver = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            requestAnimationFrame(() => {
              updateRail();
              requestAnimationFrame(updateRail);
            });
          }, {threshold: 0.01});
          railObserver.observe(rail);
        }

        window.addEventListener('load', updateRail, {once: true});
        requestAnimationFrame(updateRail);
      });
    </script>
  </body>
</html>
