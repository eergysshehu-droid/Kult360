---
import BaseLayout from '../layouts/BaseLayout.astro';
import {copy} from '../content/site-copy';
import {
  featuredJournal,
  journalImage,
  journalSlug,
  partners,
  people,
  personImage,
  projectImage,
  projectSlug,
  projects,
  strategicPillars
} from '../lib/content';
import {localizedPath} from '../lib/site-config';
import {homePage} from '../content/shell-pages';

const language = 'en';
const programmeImages = ['/media/projects/artist-hub.jpg','/media/projects/blue-heart.jpg','/media/projects/literary-voices.jpg','/media/projects/luzatart.jpg'];
const projectSelection = projects.filter((project) =>
  ['project-terminal-europe-week-2026','project-qyteti-brenda-oborrit','project-luzatart-culture'].includes(project.id)
);
const storySelection = featuredJournal.slice(0, 6);
---
<BaseLayout title={homePage.heading.en} description={homePage.description.en} {language} path="/" translations={['en','sq']}>
  <section class="pcf-hero">
    <div class="pcf-hero__media" aria-hidden="true">
      <img src="/media/projects/terminal.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="pcf-hero__veil"></div>
    <div class="pcf-hero__content container-wide">
      <p class="pcf-kicker">KULT360 Foundation · Albania</p>
      <h1>
        <span>Culture is</span>
        <span class="pcf-hero__word-cycle" aria-label="memory, movement, dialogue and a shared future">
          <b>memory.</b>
          <b>movement.</b>
          <b>dialogue.</b>
          <b>a shared future.</b>
        </span>
      </h1>
      <div class="pcf-hero__bottom">
        <p>{copy.heroBody.en}</p>
        <a href="/about/">Discover KULT360 ↗</a>
      </div>
    </div>
  </section>

  <section class="pcf-intro">
    <div class="container-wide pcf-intro__grid">
      <p class="pcf-label">About the foundation</p>
      <h2>We are an independent cultural foundation connecting artistic practice, rights, education, heritage and communities.</h2>
      <div class="pcf-intro__aside">
        <p>We create space for artists, ideas and communities to meet — locally, across the diaspora and throughout Europe.</p>
        <a class="pcf-text-link" href="/about/">About us ↗</a>
      </div>
    </div>
  </section>

  <section class="pcf-updates">
    <div class="container-wide">
      <div class="pcf-section-head">
        <div><p class="pcf-label">Latest</p><h2>News &amp; updates</h2></div>
        <a class="pcf-text-link" href="/journal/">See all ↗</a>
      </div>
      <div class="pcf-update-list">
        {featuredJournal.slice(0, 4).map((record) => (
          <a href={'/journal/' + journalSlug(record) + '/'}>
            <span>{record.category || 'Journal'}</span>
            <strong>{record.title}</strong>
            <em>{record.read_time || 'Read'}</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pcf-programmes">
    <div class="container-wide">
      <div class="pcf-section-head pcf-section-head--wide">
        <div>
          <p class="pcf-label">What we do</p>
          <h2>Four connected fields of cultural action.</h2>
        </div>
        <p>Our programmes respond to the realities artists and communities face today, while building long-term cultural capacity.</p>
      </div>
      <div class="pcf-programme-grid">
        {strategicPillars.map((item, index) => (
          <article class:list={['pcf-programme-card', 'pcf-programme-card--' + (index + 1)]}>
            <div class="pcf-programme-card__media"><img src={programmeImages[index % programmeImages.length]} alt="" loading="lazy" decoding="async" /></div>
            <div class="pcf-programme-card__body">
              <span>{String(index + 1).padStart(2,'0')}</span>
              <h3>{item.title}</h3>
              {item.summary && <p>{item.summary}</p>}
              <a href="/programs/">Discover more ↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pcf-projects">
    <div class="container-wide">
      <div class="pcf-section-head pcf-section-head--light">
        <div><p class="pcf-label">Selected projects</p><h2>Culture in practice.</h2></div>
        <a class="pcf-text-link" href="/projects/">All projects ↗</a>
      </div>
      <div class="pcf-project-grid">
        {projectSelection.map((project, index) => {
          const image = projectImage(project);
          const href = '/projects/' + projectSlug(project) + '/';
          return (
            <article class:list={['pcf-project-card', index === 0 && 'pcf-project-card--lead']}>
              <a class="pcf-project-card__media" href={href}>{image && <img src={image} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}</a>
              <div class="pcf-project-card__copy">
                <p>{project.location || project.kind.replaceAll('_',' ')}</p>
                <h3><a href={href}>{project.title}</a></h3>
                {project.summary && <p>{project.summary}</p>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="pcf-stories">
    <div class="container-wide">
      <div class="pcf-stories__heading">
        <p>Explore the stories, ideas and cultural debates shaping our work.</p>
        <h2>Culture is —</h2>
      </div>
      <div class="pcf-story-grid">
        {storySelection.map((record, index) => {
          const image = journalImage(record);
          return (
            <a class:list={['pcf-story-card','pcf-story-card--' + ((index % 4) + 1)]} href={'/journal/' + journalSlug(record) + '/'}>
              {image && <img src={image} alt="" loading="lazy" decoding="async" />}
              <span class="pcf-story-card__shade"></span>
              <div>
                <strong>— {record.title}</strong>
                <span>{record.author || 'KULT360 Journal'}</span>
              </div>
            </a>
          );
        })}
      </div>
      <a class="pcf-stories__all" href="/journal/">Discover all stories ↗</a>
    </div>
  </section>

  <section class="pcf-people">
    <div class="container-wide">
      <div class="pcf-section-head pcf-section-head--wide">
        <div><p class="pcf-label">Our team</p><h2>Meet the people behind KULT360.</h2></div>
        <p>Artists, producers, communicators and cultural practitioners building the foundation together.</p>
      </div>
      <div class="pcf-people-track">
        {people.map((person) => {
          const image = personImage(person);
          return (
            <a class="pcf-person-card" href={localizedPath('/people/' + person.id.replace(/^person-/, '') + '/', language)}>
              <div class="pcf-person-card__media">
                {image ? <img src={image} alt="" loading="lazy" decoding="async" /> : <span>{person.name.split(' ').map((part) => part[0]).join('').slice(0,2)}</span>}
              </div>
              <div><strong>{person.name}</strong><span>{person.role}</span></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="pcf-partners">
    <div class="container-wide pcf-partners__grid">
      <div><p class="pcf-label">Partners &amp; collaborators</p><h2>Culture grows through connection.</h2></div>
      <div class="pcf-partners__names">{partners.slice(0,12).map((partner) => <span>{partner.name}</span>)}</div>
    </div>
  </section>

  <section class="pcf-join">
    <div class="container-wide">
      <p class="pcf-label">Take part</p>
      <h2>Join a community shaping the future of culture.</h2>
      <a href="/get-involved/">Discover ways to support ↗</a>
    </div>
  </section>
</BaseLayout>
