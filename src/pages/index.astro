---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/content/ProjectCard.astro';
import JournalCard from '../components/content/JournalCard.astro';
import {copy} from '../content/site-copy';
import {featuredJournal, featuredProjects, partners, people, strategicPillars} from '../lib/content';
import {localizedPath} from '../lib/site-config';
import {homePage} from '../content/shell-pages';
const language = 'en';
---
<BaseLayout title={homePage.heading.en} description={homePage.description.en} {language} path="/" translations={['en','sq']}>
  <section class="hero container-wide">
    <div class="hero__copy">
      <p class="eyebrow">{copy.heroEyebrow.en}</p>
      <h1>{copy.heroTitle.en}</h1>
      <p class="hero__lede">{copy.heroBody.en}</p>
      <div class="hero__actions"><a class="button button--solid" href="/projects/">{copy.exploreProjects.en}</a><a class="button button--text" href="/get-involved/">{copy.getInvolved.en} →</a></div>
    </div>
    <figure class="hero__media">
      <div class="hero__image-frame"><img src="/media/projects/terminal.jpg" alt="TERMINAL — Europe Week 2026 at the old Shkodra railway station" fetchpriority="high" /></div>
      <figcaption><span>TERMINAL · Europe Week 2026</span><span>Shkodër</span></figcaption>
    </figure>
  </section>

  <section class="home-section container-wide">
    <div class="section-kicker"><h2>{copy.featuredProjects.en}</h2><a href="/projects/">All projects →</a></div>
    <div class="project-grid project-grid--featured">{featuredProjects.slice(0,4).map((project, index) => <ProjectCard {project} {language} {index} priority={index === 0} />)}</div>
  </section>

  <section class="home-section home-section--ink">
    <div class="container-wide">
      <div class="section-kicker section-kicker--inverse"><h2>{copy.focusAreas.en}</h2><p>Four connected fields of cultural work.</p></div>
      <div class="pillar-list">{strategicPillars.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3></article>)}</div>
    </div>
  </section>

  <section class="home-section container-wide">
    <div class="section-kicker"><h2>{copy.journal.en}</h2><a href="/journal/">Journal →</a></div>
    <div class="journal-grid">{featuredJournal.slice(0,3).map((record, index) => <JournalCard {record} {language} {index} />)}</div>
  </section>

  <section class="home-section container-wide">
    <div class="section-kicker"><h2>{copy.people.en}</h2><a href="/about/">About →</a></div>
    <div class="people-list">{people.slice(0,4).map((person) => <a class="person-row" href={localizedPath(`/people/${person.id.replace(/^person-/, '')}/`, language)}><span class="person-row__name">{person.name}</span><span class="person-row__role">{person.role}</span><span class="person-row__arrow" aria-hidden="true">→</span></a>)}</div>
  </section>

  <section class="home-section container-wide partner-home">
    <div class="section-kicker"><h2>{copy.partners.en}</h2></div>
    <div class="partner-index">{partners.slice(0,8).map((partner) => <span>{partner.name}</span>)}</div>
  </section>

  <section class="join-section"><div class="container-wide join-section__inner"><h2>Culture grows through participation.</h2><a class="button button--light" href="/get-involved/">{copy.getInvolved.en} →</a></div></section>
</BaseLayout>
