---
import BaseLayout from '../layouts/BaseLayout.astro';
import {copy} from '../content/site-copy';
import {
  featuredJournal,
  featuredProjects,
  journalImage,
  journalSlug,
  partners,
  people,
  projectImage,
  projectSlug,
  strategicPillars
} from '../lib/content';
import {localizedPath} from '../lib/site-config';
import {homePage} from '../content/shell-pages';

const language = 'en';
const leadProject = featuredProjects[0];
const secondaryProjects = featuredProjects.slice(1, 3);
const leadJournal = featuredJournal[0];
const moreJournal = featuredJournal.slice(1, 3);
---
<BaseLayout title={homePage.heading.en} description={homePage.description.en} {language} path="/" translations={['en','sq']}>
  <section class="foundation-hero foundation-hero--graphic">
    <div class="container-wide foundation-hero__meta">
      <p>KULT360 Foundation</p>
      <p>Culture · Equality · Community</p>
      <p>Albania · Europe</p>
    </div>

    <div class="container-wide foundation-hero__statement">
      <h1><span>Empowering Albanian</span><strong>artists &amp; culture.</strong></h1>
      <div class="foundation-hero__side">
        <p>{copy.heroBody.en}</p>
        <div class="foundation-hero__actions">
          <a href="/projects/">{copy.exploreProjects.en} <span aria-hidden="true">↗</span></a>
          <a href="/get-involved/">{copy.getInvolved.en} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <figure class="foundation-hero__visual">
      <div class="foundation-hero__image-wrap">
        <img src="/media/projects/terminal.jpg" alt="TERMINAL — Europe Week 2026 at the old Shkodra railway station" fetchpriority="high" />
      </div>
      <figcaption class="container-wide">
        <span>TERMINAL · Europe Week 2026</span>
        <span>Old Railway Station · Shkodër</span>
      </figcaption>
    </figure>
  </section>

  <div class="foundation-marquee" aria-label="KULT360 focus areas">
    <div class="foundation-marquee__track">
      <span>ART</span><i>●</i><span>RIGHTS</span><i>●</i><span>EDUCATION</span><i>●</i><span>HERITAGE</span><i>●</i><span>COMMUNITY</span><i>●</i><span>EUROPE</span><i>●</i>
      <span aria-hidden="true">ART</span><i aria-hidden="true">●</i><span aria-hidden="true">RIGHTS</span><i aria-hidden="true">●</i><span aria-hidden="true">EDUCATION</span><i aria-hidden="true">●</i><span aria-hidden="true">HERITAGE</span><i aria-hidden="true">●</i><span aria-hidden="true">COMMUNITY</span><i aria-hidden="true">●</i><span aria-hidden="true">EUROPE</span><i aria-hidden="true">●</i>
    </div>
  </div>

  <section class="foundation-manifesto">
    <div class="container-wide foundation-manifesto__grid">
      <p class="foundation-label">Why KULT360</p>
      <p class="foundation-manifesto__copy">We connect artistic practice, cultural rights, education, heritage and communities — turning culture into a public force for participation and change.</p>
      <div class="foundation-manifesto__aside">
        <p>{copy.heroBody.en}</p>
        <a class="foundation-link" href="/about/">About the foundation ↗</a>
      </div>
    </div>
  </section>

  <section class="foundation-projects">
    <div class="container-wide foundation-heading foundation-heading--project">
      <div>
        <p class="foundation-label">Selected work</p>
        <h2>Projects with a place, a voice and a reason to exist.</h2>
      </div>
      <a class="foundation-link" href="/projects/">View all projects ↗</a>
    </div>

    {leadProject && (() => {
      const image = projectImage(leadProject);
      const href = '/projects/' + projectSlug(leadProject) + '/';
      return (
        <article class="foundation-project-feature container-wide">
          <a class="foundation-project-feature__media" href={href}>
            {image && <img src={image} alt="" loading="eager" decoding="async" />}
          </a>
          <div class="foundation-project-feature__panel">
            <p class="foundation-project__index">01</p>
            <p class="foundation-project__meta">{leadProject.location || leadProject.kind.replaceAll('_', ' ')}</p>
            <h3><a href={href}>{leadProject.title}</a></h3>
            {leadProject.summary && <p>{leadProject.summary}</p>}
            <a class="foundation-link" href={href}>Open project ↗</a>
          </div>
        </article>
      );
    })()}

    <div class="container-wide foundation-project-grid">
      {secondaryProjects.map((project, index) => {
        const image = projectImage(project);
        const href = '/projects/' + projectSlug(project) + '/';
        return (
          <article class="foundation-project-tile">
            <a class="foundation-project-tile__media" href={href}>{image && <img src={image} alt="" loading="lazy" decoding="async" />}</a>
            <div class="foundation-project-tile__copy">
              <div><span>{String(index + 2).padStart(2, '0')}</span><span>{project.location || project.kind.replaceAll('_', ' ')}</span></div>
              <h3><a href={href}>{project.title}</a></h3>
              <a class="foundation-link" href={href}>Open project ↗</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="foundation-focus">
    <div class="container-wide foundation-heading foundation-heading--focus">
      <div><p class="foundation-label">360° action</p><h2>{copy.focusAreas.en}</h2></div>
      <p>Four connected fields. One cultural ecosystem.</p>
    </div>
    <div class="foundation-focus__rows">
      {strategicPillars.map((item, index) => (
        <article class="foundation-focus__row">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <i aria-hidden="true">↗</i>
        </article>
      ))}
    </div>
  </section>

  <section class="foundation-journal">
    <div class="container-wide foundation-heading foundation-heading--light">
      <div><p class="foundation-label">Journal</p><h2>Ideas, criticism, memory and cultural conversation.</h2></div>
      <a class="foundation-link" href="/journal/">Explore Journal ↗</a>
    </div>

    {leadJournal && (
      <div class="container-wide foundation-journal__lead">
        {journalImage(leadJournal) && <a class="foundation-journal__image" href={'/journal/' + journalSlug(leadJournal) + '/'}><img src={journalImage(leadJournal)} alt="" loading="lazy" decoding="async" /></a>}
        <div class="foundation-journal__lead-copy">
          <p class="foundation-label">{[leadJournal.category, leadJournal.read_time].filter(Boolean).join(' · ')}</p>
          <h3><a href={'/journal/' + journalSlug(leadJournal) + '/'}>{leadJournal.title}</a></h3>
          <p>{leadJournal.author || 'KULT360 Journal'}</p>
          <a class="foundation-link" href={'/journal/' + journalSlug(leadJournal) + '/'}>Read article ↗</a>
        </div>
      </div>
    )}

    <div class="container-wide foundation-journal__list">
      {moreJournal.map((record, index) => (
        <article>
          <span>{String(index + 2).padStart(2, '0')}</span>
          <div><p class="foundation-label">{[record.category, record.read_time].filter(Boolean).join(' · ')}</p><h3><a href={'/journal/' + journalSlug(record) + '/'}>{record.title}</a></h3></div>
          {journalImage(record) && <img src={journalImage(record)} alt="" loading="lazy" decoding="async" />}
        </article>
      ))}
    </div>
  </section>

  <section class="foundation-people">
    <div class="container-wide foundation-heading">
      <div><p class="foundation-label">People</p><h2>A foundation is the people who carry its work.</h2></div>
      <a class="foundation-link" href="/about/">About KULT360 ↗</a>
    </div>
    <div class="container-wide foundation-people__list">
      {people.map((person, index) => (
        <a href={localizedPath('/people/' + person.id.replace(/^person-/, '') + '/', language)}>
          <span>{String(index + 1).padStart(2, '0')}</span><strong>{person.name}</strong><em>{person.role}</em><i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </section>

  <section class="foundation-partners">
    <div class="container-wide foundation-partners__grid">
      <div>
        <p class="foundation-label">Partners &amp; collaborators</p>
        <h2>Built through collaboration.</h2>
        <div class="foundation-partners__names">{partners.slice(0, 12).map((partner) => <span>{partner.name}</span>)}</div>
      </div>
      <figure><img src="/media/partners/collage.jpg" alt="KULT360 partners and collaborators" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="foundation-cta">
    <div class="container-wide">
      <p class="foundation-label">Take part</p>
      <h2>Culture grows when people enter the conversation.</h2>
      <a href="/get-involved/">Get involved <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
