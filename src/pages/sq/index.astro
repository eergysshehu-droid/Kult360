---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {copy} from '../../content/site-copy';
import {
  featuredJournal,
  featuredProjects,
  journalImage,
  journalSlug,
  partners,
  people,
  projectImage,
  projectSlug,
  strategicPillars
} from '../../lib/content';
import {localizedPath} from '../../lib/site-config';
import {homePage} from '../../content/shell-pages';

const language = 'sq';
const leadProject = featuredProjects[0];
const secondaryProjects = featuredProjects.slice(1, 3);
const leadJournal = featuredJournal[0];
const moreJournal = featuredJournal.slice(1, 3);
---
<BaseLayout title={homePage.heading.sq} description={homePage.description.sq} {language} path="/sq/" translations={['en','sq']}>
  <section class="foundation-hero foundation-hero--graphic">
    <div class="container-wide foundation-hero__meta">
      <p>Fondacioni KULT360</p>
      <p>Kulturë · Barazi · Komunitet</p>
      <p>Shqipëri · Europë</p>
    </div>

    <div class="container-wide foundation-hero__statement">
      <h1><span>Fuqizojmë artistët</span><strong>dhe kulturën shqiptare.</strong></h1>
      <div class="foundation-hero__side">
        <p>{copy.heroBody.sq}</p>
        <div class="foundation-hero__actions">
          <a href="/sq/projects/">{copy.exploreProjects.sq} <span aria-hidden="true">↗</span></a>
          <a href="/sq/get-involved/">{copy.getInvolved.sq} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <figure class="foundation-hero__visual">
      <div class="foundation-hero__image-wrap">
        <img src="/media/projects/terminal.jpg" alt="TERMINAL — Europe Week 2026, stacioni i vjetër hekurudhor i Shkodrës" fetchpriority="high" />
      </div>
      <figcaption class="container-wide"><span>TERMINAL · Europe Week 2026</span><span>Stacioni i Vjetër Hekurudhor · Shkodër</span></figcaption>
    </figure>
  </section>

  <div class="foundation-marquee" aria-label="Fushat e KULT360">
    <div class="foundation-marquee__track">
      <span>ART</span><i>●</i><span>TË DREJTAT</span><i>●</i><span>EDUKIM</span><i>●</i><span>TRASHËGIMI</span><i>●</i><span>KOMUNITET</span><i>●</i><span>EUROPË</span><i>●</i>
      <span aria-hidden="true">ART</span><i aria-hidden="true">●</i><span aria-hidden="true">TË DREJTAT</span><i aria-hidden="true">●</i><span aria-hidden="true">EDUKIM</span><i aria-hidden="true">●</i><span aria-hidden="true">TRASHËGIMI</span><i aria-hidden="true">●</i><span aria-hidden="true">KOMUNITET</span><i aria-hidden="true">●</i><span aria-hidden="true">EUROPË</span><i aria-hidden="true">●</i>
    </div>
  </div>

  <section class="foundation-manifesto">
    <div class="container-wide foundation-manifesto__grid">
      <p class="foundation-label">Pse KULT360</p>
      <p class="foundation-manifesto__copy">Ne lidhim praktikën artistike, të drejtat kulturore, edukimin, trashëgiminë dhe komunitetet — duke e kthyer kulturën në një forcë publike për pjesëmarrje dhe ndryshim.</p>
      <div class="foundation-manifesto__aside"><p>{copy.heroBody.sq}</p><a class="foundation-link" href="/sq/about/">Rreth fondacionit ↗</a></div>
    </div>
  </section>

  <section class="foundation-projects">
    <div class="container-wide foundation-heading foundation-heading--project">
      <div><p class="foundation-label">Punë të zgjedhura</p><h2>Projekte me një vend, një zë dhe një arsye për të ekzistuar.</h2></div>
      <a class="foundation-link" href="/sq/projects/">Të gjitha projektet ↗</a>
    </div>

    {leadProject && (() => {
      const image = projectImage(leadProject);
      const href = '/sq/projects/' + projectSlug(leadProject) + '/';
      return (
        <article class="foundation-project-feature container-wide">
          <a class="foundation-project-feature__media" href={href}>{image && <img src={image} alt="" loading="eager" decoding="async" />}</a>
          <div class="foundation-project-feature__panel">
            <p class="foundation-project__index">01</p><p class="foundation-project__meta">{leadProject.location || leadProject.kind.replaceAll('_', ' ')}</p>
            <h3><a href={href}>{leadProject.title}</a></h3>{leadProject.summary && <p>{leadProject.summary}</p>}<a class="foundation-link" href={href}>Hap projektin ↗</a>
          </div>
        </article>
      );
    })()}

    <div class="container-wide foundation-project-grid">
      {secondaryProjects.map((project, index) => {
        const image = projectImage(project); const href = '/sq/projects/' + projectSlug(project) + '/';
        return (
          <article class="foundation-project-tile">
            <a class="foundation-project-tile__media" href={href}>{image && <img src={image} alt="" loading="lazy" decoding="async" />}</a>
            <div class="foundation-project-tile__copy"><div><span>{String(index + 2).padStart(2, '0')}</span><span>{project.location || project.kind.replaceAll('_', ' ')}</span></div><h3><a href={href}>{project.title}</a></h3><a class="foundation-link" href={href}>Hap projektin ↗</a></div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="foundation-focus">
    <div class="container-wide foundation-heading foundation-heading--focus"><div><p class="foundation-label">Veprim 360°</p><h2>{copy.focusAreas.sq}</h2></div><p>Katër fusha të lidhura. Një ekosistem kulturor.</p></div>
    <div class="foundation-focus__rows">{strategicPillars.map((item, index) => <article class="foundation-focus__row"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><i aria-hidden="true">↗</i></article>)}</div>
  </section>

  <section class="foundation-journal">
    <div class="container-wide foundation-heading foundation-heading--light"><div><p class="foundation-label">Journal</p><h2>Ide, kritikë, kujtesë dhe bisedë kulturore.</h2></div><a class="foundation-link" href="/sq/journal/">Shiko Journal ↗</a></div>
    {leadJournal && <div class="container-wide foundation-journal__lead">{journalImage(leadJournal) && <a class="foundation-journal__image" href={'/sq/journal/' + journalSlug(leadJournal) + '/'}><img src={journalImage(leadJournal)} alt="" loading="lazy" decoding="async" /></a>}<div class="foundation-journal__lead-copy"><p class="foundation-label">{[leadJournal.category, leadJournal.read_time].filter(Boolean).join(' · ')}</p><h3><a href={'/sq/journal/' + journalSlug(leadJournal) + '/'}>{leadJournal.title}</a></h3><p>{leadJournal.author || 'KULT360 Journal'}</p><a class="foundation-link" href={'/sq/journal/' + journalSlug(leadJournal) + '/'}>Lexo artikullin ↗</a></div></div>}
    <div class="container-wide foundation-journal__list">{moreJournal.map((record, index) => <article><span>{String(index + 2).padStart(2, '0')}</span><div><p class="foundation-label">{[record.category, record.read_time].filter(Boolean).join(' · ')}</p><h3><a href={'/sq/journal/' + journalSlug(record) + '/'}>{record.title}</a></h3></div>{journalImage(record) && <img src={journalImage(record)} alt="" loading="lazy" decoding="async" />}</article>)}</div>
  </section>

  <section class="foundation-people">
    <div class="container-wide foundation-heading"><div><p class="foundation-label">Ekipi</p><h2>Një fondacion është njerëzit që e mbajnë punën e tij.</h2></div><a class="foundation-link" href="/sq/about/">Rreth KULT360 ↗</a></div>
    <div class="container-wide foundation-people__list">{people.map((person, index) => <a href={localizedPath('/people/' + person.id.replace(/^person-/, '') + '/', language)}><span>{String(index + 1).padStart(2, '0')}</span><strong>{person.name}</strong><em>{person.role}</em><i aria-hidden="true">↗</i></a>)}</div>
  </section>

  <section class="foundation-partners"><div class="container-wide foundation-partners__grid"><div><p class="foundation-label">Partnerë &amp; bashkëpunëtorë</p><h2>E ndërtuar përmes bashkëpunimit.</h2><div class="foundation-partners__names">{partners.slice(0, 12).map((partner) => <span>{partner.name}</span>)}</div></div><figure><img src="/media/partners/collage.jpg" alt="Partnerë dhe bashkëpunëtorë të KULT360" loading="lazy" decoding="async" /></figure></div></section>

  <section class="foundation-cta"><div class="container-wide"><p class="foundation-label">Bëhu pjesë</p><h2>Kultura rritet kur njerëzit hyjnë në bisedë.</h2><a href="/sq/get-involved/">Përfshihu <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
