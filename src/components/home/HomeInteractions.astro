<script>
  const heroDial = document.querySelector<HTMLElement>('[data-hero-dial]');
  const dialRotor = heroDial?.querySelector<HTMLElement>('[data-dial-rotor]');
  const dialLive = document.querySelector<HTMLElement>('[data-dial-live]');
  const dialItems = dialRotor ? Array.from(dialRotor.querySelectorAll<HTMLElement>('[data-dial-index]')) : [];

  if (heroDial && dialRotor && dialItems.length) {
    const count = dialItems.length;
    const stepDeg = 360 / count;
    const stepMs = 4100;
    const motionMs = 980;
    let active = 0;
    let clock = 0;
    let settleTimer = 0;
    let liveTimer = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const stateFor = (index: number) => {
      const delta = (index - active + count) % count;
      if (delta === 0) return 'active';
      if (delta === 1) return 'near-next';
      if (delta === count - 1) return 'near-prev';
      if (delta === 2) return 'far-next';
      if (delta === count - 2) return 'far-prev';
      return 'hidden';
    };

    const labelFor = (index: number) =>
      (dialItems[index]?.querySelector<HTMLElement>('.pcf-hero__dial-label')?.textContent || '').trim().toUpperCase();

    const setDialStates = () => {
      dialItems.forEach((item, index) => {
        item.dataset.dialState = stateFor(index);
      });
    };

    const dialMeasure = dialLive?.cloneNode(false) as HTMLElement | undefined;
    if (dialMeasure && dialLive?.parentElement) {
      dialMeasure.removeAttribute('data-dial-live');
      dialMeasure.removeAttribute('aria-live');
      dialMeasure.setAttribute('aria-hidden', 'true');
      dialMeasure.classList.add('pcf-hero__dial-measurer');
      dialLive.parentElement.appendChild(dialMeasure);
    }

    const measureLabel = (label: string) => {
      if (!dialMeasure) return 0;
      dialMeasure.textContent = label;
      return Math.ceil(dialMeasure.getBoundingClientRect().width);
    };

    const setLiveWidth = (label: string, animate = true) => {
      if (!dialLive) return;
      const width = measureLabel(label);
      if (!width) return;
      if (!animate) dialLive.classList.add('is-width-instant');
      dialLive.style.width = `${width}px`;
      if (!animate) requestAnimationFrame(() => dialLive.classList.remove('is-width-instant'));
    };

    const setLiveLabel = (animate = true) => {
      if (!dialLive) return;
      window.clearTimeout(liveTimer);
      const nextLabel = labelFor(active);

      if (!animate || reducedMotion) {
        dialLive.textContent = nextLabel;
        setLiveWidth(nextLabel, false);
        dialLive.classList.remove('is-changing');
        return;
      }

      setLiveWidth(nextLabel, true);
      dialLive.classList.add('is-changing');
      liveTimer = window.setTimeout(() => {
        dialLive.textContent = nextLabel;
        requestAnimationFrame(() => dialLive.classList.remove('is-changing'));
      }, 330);
    };

    const setRotation = (animate = true) => {
      const turn = active * stepDeg;
      if (!animate) dialRotor.classList.add('is-instant');
      dialRotor.style.setProperty('--dial-turn', `${turn}deg`);
      dialRotor.style.transform = `rotate(-${turn}deg)`;
      if (!animate) requestAnimationFrame(() => dialRotor.classList.remove('is-instant'));
    };

    const advance = () => {
      window.clearTimeout(settleTimer);
      active = (active + 1) % count;
      setLiveLabel(!reducedMotion);
      setRotation(!reducedMotion);
      settleTimer = window.setTimeout(setDialStates, reducedMotion ? 0 : Math.round(motionMs * .72));
    };

    const startClock = () => {
      window.clearInterval(clock);
      if (document.hidden || reducedMotion) return;
      clock = window.setInterval(advance, stepMs);
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        window.clearInterval(clock);
        window.clearTimeout(settleTimer);
        window.clearTimeout(liveTimer);
      } else {
        setRotation(false);
        setDialStates();
        setLiveLabel(false);
        startClock();
      }
    });

    setRotation(false);
    setDialStates();
    setLiveLabel(false);
    document.fonts?.ready.then(() => setLiveLabel(false));
    let liveResizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(liveResizeTimer);
      liveResizeTimer = window.setTimeout(() => setLiveLabel(false), 120);
    }, {passive: true});
    startClock();
  }

  const teamRail = document.querySelector('[data-team-rail]');
  if (teamRail instanceof HTMLElement) {
    let teamRailTouched = false;
    let teamRailEntryLocked = false;

    const resetTeamRail = () => {
      teamRail.scrollTo({left: 0, top: 0, behavior: 'auto'});
    };

    const resetSequence = () => {
      if (teamRailTouched) return;
      resetTeamRail();
      requestAnimationFrame(() => {
        resetTeamRail();
        requestAnimationFrame(resetTeamRail);
      });
      window.setTimeout(resetTeamRail, 80);
      window.setTimeout(resetTeamRail, 220);
      window.setTimeout(resetTeamRail, 650);
    };

    const markTeamRailTouched = () => {
      teamRailTouched = true;
    };

    teamRail.addEventListener('pointerdown', markTeamRailTouched, {passive: true});
    teamRail.addEventListener('touchstart', markTeamRailTouched, {passive: true});
    teamRail.addEventListener('wheel', markTeamRailTouched, {passive: true});

    resetSequence();
    window.addEventListener('load', resetSequence, {once: true});
    window.addEventListener('pageshow', () => {
      teamRailTouched = false;
      teamRailEntryLocked = false;
      resetSequence();
    }, {passive: true});

    if ('IntersectionObserver' in window) {
      const teamObserver = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting || teamRailEntryLocked || teamRailTouched) return;
        teamRailEntryLocked = true;
        resetSequence();
        window.setTimeout(resetSequence, 350);
      }, {threshold: 0.18});
      teamObserver.observe(teamRail);
    }
  }
</script>
