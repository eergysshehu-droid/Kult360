---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import PartnerMarquee from './PartnerMarquee.astro';
import {programFocusAreas, type ProgramFocusArea} from '../../content/program-focus';
import {cultureThemes} from '../../content/themes';
import {projects} from '../../lib/content';
import {localizedPath, type Language} from '../../lib/site-config';

interface Props {program: ProgramFocusArea; language: Language}
const {program, language} = Astro.props;
const relatedProjects = program.relatedProjectIds
  .map((id) => projects.find((project) => project.id === id))
  .filter((project) => project !== undefined);
const programIndex = programFocusAreas.findIndex((item) => item.slug === program.slug);
const previous = programFocusAreas[(programIndex - 1 + programFocusAreas.length) % programFocusAreas.length];
const next = programFocusAreas[(programIndex + 1) % programFocusAreas.length];
const path = localizedPath(`/programs/${program.slug}/`, language);
const words = program.title[language].split(' ');
const relatedThemes = cultureThemes.filter((theme) => theme.relatedProgramSlugs.includes(program.slug));
---
<BaseLayout title={program.title[language]} description={program.summary[language]} {language} {path} translations={['en', 'sq']}>
  <article class="program-detail" style={`--program-accent:${program.accent}`}>
    <header class="program-detail__hero">
      <div class="program-detail__orbit" aria-hidden="true">
        <img src="/media/brand/kult360-orbit-source.png" alt="" />
      </div>
      <div class="container-wide program-detail__hero-inner">
        <div class="program-detail__hero-top">
          <a href={localizedPath('/programs/', language)}>← {language === 'sq' ? 'Të gjitha programet' : 'All programs'}</a>
          <span>{program.number} / 04</span>
        </div>
        <div class="program-detail__title-grid">
          <p class="program-detail__eyebrow">{language === 'sq' ? 'Fushë strategjike' : 'Strategic focus area'}</p>
          <h1>{words.map((word) => <span>{word}</span>)}</h1>
          <p class="program-detail__summary">{program.summary[language]}</p>
        </div>
        <a class="program-detail__scroll" href="#approach">
          <span>{language === 'sq' ? 'Shiko qasjen' : 'Explore the approach'}</span>
          <i aria-hidden="true">↓</i>
        </a>
      </div>
    </header>

    <section class="container-wide program-detail__statement" id="approach">
      <div class="program-detail__section-label"><span>{program.number}</span><p>{language === 'sq' ? 'Ideja qendrore' : 'The central idea'}</p></div>
      <div>
        <h2>{program.statement[language]}</h2>
        <p>{program.introduction[language]}</p>
      </div>
    </section>

    <section class="program-detail__principles">
      <div class="container-wide">
        <div class="program-detail__section-head">
          <p>{language === 'sq' ? 'Si punojmë' : 'How we work'}</p>
          <span>{language === 'sq' ? 'Tre parime pune' : 'Three working principles'}</span>
        </div>
        <div class="program-detail__principle-grid">
          {program.principles.map((principle, index) => {
            const href = program.slug === 'heritage-sustainability' && index === 1
              ? localizedPath('/programs/heritage-sustainability/listen-to-place/', language)
              : undefined;
            return href ? (
              <a class="program-detail__principle-card program-detail__principle-card--link" href={href}>
                <span>0{index + 1}</span>
                <h3>{principle.title[language]}</h3>
                <p>{principle.body[language]}</p>
                <i aria-hidden="true">↗</i>
              </a>
            ) : (
              <article class="program-detail__principle-card">
                <span>0{index + 1}</span>
                <h3>{principle.title[language]}</h3>
                <p>{principle.body[language]}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    {relatedThemes.length > 0 && (
      <section class="container-wide program-detail__themes">
        <div class="program-detail__section-head">
          <p>{language === 'sq' ? 'Tema ndërsektoriale' : 'Cross-cutting themes'}</p>
          <span>{language === 'sq' ? 'Shko më thellë' : 'Go deeper'}</span>
        </div>
        <div class="program-detail__theme-grid">
          {relatedThemes.map((theme) => (
            <a href={localizedPath(`/themes/${theme.slug}/`, language)} style={`--theme-accent:${theme.accent}`}>
              <span>{theme.number}</span>
              <strong>{theme.title[language]}</strong>
              <p>{theme.summary[language]}</p>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="container-wide program-detail__projects">
      <div class="program-detail__section-head">
        <p>{language === 'sq' ? 'Nga arkivi' : 'From the archive'}</p>
        <a href={localizedPath('/projects/', language)}>{language === 'sq' ? 'Të gjitha projektet' : 'All projects'} ↗</a>
      </div>
      <div class="program-detail__project-grid">
        {relatedProjects.map((project, index) => <ProjectCard {project} {language} priority={index === 0} />)}
      </div>
    </section>

    <section class="program-detail__partners">
      <div class="container-wide program-detail__section-head">
        <p>{language === 'sq' ? 'Rrjeti ynë' : 'Our network'}</p>
        <span>{language === 'sq' ? 'Partnerë & bashkëpunëtorë' : 'Partners & collaborators'}</span>
      </div>
      <PartnerMarquee {language} />
    </section>

    <nav class="container-wide program-detail__next" aria-label={language === 'sq' ? 'Programet' : 'Programs'}>
      <a href={localizedPath(`/programs/${previous.slug}/`, language)}>
        <span>← {language === 'sq' ? 'Më parë' : 'Previous'}</span>
        <strong>{previous.title[language]}</strong>
      </a>
      <a href={localizedPath(`/programs/${next.slug}/`, language)}>
        <span>{language === 'sq' ? 'Më tej' : 'Next'} →</span>
        <strong>{next.title[language]}</strong>
      </a>
    </nav>
  </article>
</BaseLayout>
