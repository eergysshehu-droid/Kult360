---
import {localizedPath, type Language} from '../../lib/site-config';
import {journalImage, journalSlug, type JournalRecord} from '../../lib/content';
interface Props {record: JournalRecord; language: Language; index?: number}
const {record, language, index} = Astro.props;
const image = journalImage(record);
const href = localizedPath(`/journal/${journalSlug(record)}/`, language);
---
<article class="journal-card">
  {image && <a class="journal-card__media" href={href}><img src={image} alt="" loading="lazy" decoding="async" /><span aria-hidden="true">↗</span></a>}
  <div class="journal-card__body">
    <div class="journal-card__meta"><p class="meta">{[record.category, record.author, record.read_time].filter(Boolean).join(' · ')}</p>{typeof index === 'number' && <span>{String(index + 1).padStart(2, '0')}</span>}</div>
    <h3><a href={href}>{record.title}</a></h3>
  </div>
</article>
