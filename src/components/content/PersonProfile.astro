---
import {getTeamProfile} from '../../content/team-profiles';
import ProjectCard from './ProjectCard.astro';
import {people, personImage, personSlug, projects, type Person} from '../../lib/content';
import {localizedPath, type Language} from '../../lib/site-config';

interface Props {
  person: Person;
  language: Language;
}

const {person, language} = Astro.props;
const profile = getTeamProfile(person.id);
const image = personImage(person);
const personRelationName = person.id.replace(/^person-/, '').replaceAll('-', ' ').toLowerCase();
const selectedProjects = projects
  .filter((project) => project.people?.some((entry) => {
    const raw = entry.trim().toLowerCase();
    const normalized = raw.replace(/^person-/, '').replaceAll('-', ' ');
    return raw === person.id.toLowerCase()
      || normalized === personRelationName
      || normalized === person.name.toLowerCase();
  }))
  .slice(0, 4);
const personIndex = people.findIndex((item) => item.id === person.id);
const previousPerson = people[(personIndex - 1 + people.length) % people.length];
const nextPerson = people[(personIndex + 1) % people.length];
const heroIntro = profile?.bio[0]?.match(/^.*?[.!?](?:\s|$)/)?.[0]?.trim() || profile?.bio[0];
const t = language === 'sq' ? {
  about: 'Profili',
  languages: 'Gjuhët',
  archive: 'Profili i arkivit',
  source: 'Përmbajtje e dhënë nga KULT360',
  portrait: 'Portreti do të shtohet',
  biography: 'Biografia',
  focus: 'Fushat e fokusit',
  selectedWork: 'Punë e përzgjedhur',
  allProjects: 'Të gjitha projektet',
  previousPerson: 'Profili i mëparshëm',
  nextPerson: 'Profili tjetër'
} : {
  about: 'Profile',
  languages: 'Languages',
  archive: 'Archive profile',
  source: 'Content supplied by KULT360',
  portrait: 'Portrait to be added',
  biography: 'Biography',
  focus: 'Focus areas',
  selectedWork: 'Selected work',
  allProjects: 'All projects',
  previousPerson: 'Previous profile',
  nextPerson: 'Next profile'
};
---
<div class="team-profile-page">
  <header class="team-profile-hero">
    <div class="team-profile-hero__copy">
      <p class="eyebrow">{language === 'sq' ? 'Ekipi' : 'People'} / {person.role}</p>
      <h1>{person.name}</h1>
      <p class="team-profile-role">{person.role}</p>

      {heroIntro && <p class="team-profile-intro">{heroIntro}</p>}

      {profile?.quote && (
        <blockquote class="team-profile-quote">
          <p>“{profile.quote}”</p>
          {profile.quoteBy && <cite>— {profile.quoteBy}</cite>}
        </blockquote>
      )}

      {selectedProjects.length > 0 && (
        <a class="team-profile-hero__cta" href="#selected-work">
          {t.selectedWork} <span aria-hidden="true">↓</span>
        </a>
      )}
    </div>

    <div class="team-profile-hero__media">
      {image ? (
        <img src={image} alt={person.name} loading="eager" decoding="async" />
      ) : (
        <div class="team-profile-portrait-placeholder" aria-label={person.name + ' portrait unavailable'}>
          <span>{person.name.split(' ').map((part) => part[0]).join('').slice(0, 2)}</span>
          <small>{t.portrait}</small>
        </div>
      )}
    </div>
  </header>

  {profile && (
    <>
      <div class="team-profile-core">
        <section class="team-profile-bio">
          <p class="team-profile-section-label"><span>01</span>{t.biography}</p>
          <div class="team-profile-bio__copy">
            {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="team-profile-focus">
          <div class="team-profile-section-kicker"><span>02</span><h2>{t.focus}</h2></div>
          <div class="team-profile-highlights">
            {profile.highlightColumns.map((column) => (
              <article>
                <h3>{column.title}</h3>
                <ul>
                  {column.items.map((item) => (
                    <li>
                      {item.title && <strong>{item.title}:</strong>}
                      <span>{item.body}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      </div>

      {selectedProjects.length > 0 && (
        <section class="team-profile-work" id="selected-work">
          <div class="team-profile-section-kicker team-profile-section-kicker--work">
            <span>03</span>
            <h2>{t.selectedWork}</h2>
            <a href={localizedPath('/projects/', language)}>{t.allProjects} ↗</a>
          </div>
          <div class="team-profile-work__rail">
            {selectedProjects.map((project) => <ProjectCard {project} {language} />)}
          </div>
        </section>
      )}

      {profile.languages && (
        <section class="team-profile-languages">
          <span>{t.languages}</span>
          <p>{profile.languages}</p>
        </section>
      )}

      <div class="team-profile-sections">
        {profile.sections.map((section, sectionIndex) => (
          <section class="team-profile-section">
            <div class="team-profile-section__head">
              <span>{String(sectionIndex + 1).padStart(2, '0')}</span>
              <h2>{section.title}</h2>
            </div>
            <div class="team-profile-section__grid">
              {section.items.map((item) => (
                <article class="team-profile-item">
                  {item.title && <h3>{item.title}</h3>}
                  <p>{item.body}</p>
                  {item.meta && <span>{item.meta}</span>}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </>
  )}

  <nav class="team-profile-next" aria-label={language === 'sq' ? 'Profilet e ekipit' : 'People profiles'}>
    <a href={localizedPath(`/people/${personSlug(previousPerson)}/`, language)}>
      <span>← {t.previousPerson}</span>
      <strong>{previousPerson.name}</strong>
    </a>
    <a href={localizedPath(`/people/${personSlug(nextPerson)}/`, language)}>
      <span>{t.nextPerson} →</span>
      <strong>{nextPerson.name}</strong>
    </a>
  </nav>

  <footer class="team-profile-source">
    <span>{t.source}</span>
    {person.source_url && <a href={person.source_url} rel="noreferrer">{t.archive} ↗</a>}
  </footer>
</div>

<style is:global>.team-profile-page{width:min(100%,78rem);margin-inline:auto;}.team-profile-hero{position:relative;isolation:isolate;overflow:clip;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(18rem,.7fr);gap:clamp(2.2rem,5vw,5rem);align-items:end;padding-bottom:clamp(3rem,5vw,4.8rem);border-bottom:1px solid rgba(9,9,8,.18);}.team-profile-hero::after{content:'';position:absolute;z-index:-1;right:-8rem;top:48%;width:22rem;aspect-ratio:1;border:1px solid rgba(9,9,8,.12);border-radius:50%;box-shadow:0 0 0 3.6rem rgba(9,9,8,.035),0 0 0 7rem rgba(232,189,0,.045);transform:translateY(-50%);pointer-events:none;}.team-profile-hero::before{content:'';position:absolute;z-index:0;right:2.35rem;top:25%;width:.42rem;aspect-ratio:1;border-radius:50%;background:var(--ref-yellow);pointer-events:none;}.team-profile-hero__copy,.team-profile-hero__media{position:relative;z-index:1;}.team-profile-hero__copy{display:grid;gap:.72rem;align-content:end;}.team-profile-hero h1{margin:0;max-width:11ch;font-family:var(--font-sans);font-size:clamp(3.1rem,5vw,5.25rem);line-height:.92;letter-spacing:-.056em;font-weight:690;text-wrap:balance;}.team-profile-role{margin:0;color:var(--ref-muted);font-size:.92rem;}.team-profile-intro{max-width:42rem;margin:1.1rem 0 0;color:#49453f;font-size:clamp(1rem,1.35vw,1.2rem);line-height:1.55;}.team-profile-quote{max-width:40rem;margin:1.2rem 0 0;padding:1rem 0 0;border-top:1px solid rgba(9,9,8,.18);}.team-profile-quote p{margin:0;color:#5b564e;font-size:clamp(.98rem,1.25vw,1.12rem);line-height:1.5;letter-spacing:-.012em;}.team-profile-quote cite{display:block;margin-top:.6rem;font-style:normal;color:var(--ref-muted);font-size:.62rem;text-transform:uppercase;letter-spacing:.07em;}.team-profile-hero__cta{width:max-content;max-width:100%;min-height:2.75rem;display:inline-flex;align-items:center;gap:.75rem;margin-top:.55rem;color:inherit;font-size:.64rem;font-weight:830;letter-spacing:.075em;text-decoration:none;text-transform:uppercase;}.team-profile-hero__cta span{width:2.25rem;aspect-ratio:1;display:grid;place-items:center;border:1px solid rgba(9,9,8,.25);border-radius:50%;color:var(--ref-yellow);}.team-profile-hero__media{width:min(100%,27rem);max-height:34rem;aspect-ratio:4/5;justify-self:end;align-self:end;background:transparent;overflow:hidden;}.team-profile-hero__media::after{content:'';position:absolute;inset:0 auto 0 0;width:2px;background:var(--ref-yellow);opacity:.72;pointer-events:none;}.team-profile-hero__media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;}.team-profile-portrait-placeholder{width:100%;height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:1.1rem;background:#151514;color:#fff;}.team-profile-portrait-placeholder>span{align-self:center;margin:auto;color:var(--ref-yellow);font-size:clamp(3.6rem,6vw,5.5rem);letter-spacing:-.06em;font-weight:650;}.team-profile-portrait-placeholder small{color:#9b978f;font-size:.62rem;text-transform:uppercase;letter-spacing:.07em;}.team-profile-core{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(19rem,.92fr);gap:clamp(2.4rem,5vw,5rem);align-items:start;padding-block:clamp(3.8rem,6.5vw,6rem);border-bottom:1px solid rgba(9,9,8,.18);}.team-profile-bio{display:grid;gap:1.5rem;min-width:0;}.team-profile-section-label{display:flex;align-items:baseline;gap:.7rem;margin:0;font-size:.64rem;text-transform:uppercase;letter-spacing:.1em;font-weight:850;}.team-profile-section-label>span,.team-profile-section-kicker>span{color:var(--ref-yellow);font-size:.6rem;font-weight:850;letter-spacing:.08em;}.team-profile-bio__copy{width:min(100%,43rem);}.team-profile-bio__copy p{margin:0;font-size:clamp(1.03rem,1.3vw,1.18rem);line-height:1.7;}.team-profile-bio__copy p+p{margin-top:1.3rem}.team-profile-focus{min-width:0;}.team-profile-work{padding-block:clamp(3.8rem,6vw,5.5rem);border-bottom:1px solid rgba(9,9,8,.18);}.team-profile-section-kicker{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;gap:1rem;align-items:baseline;padding-bottom:1rem;border-bottom:1px solid rgba(9,9,8,.16);}.team-profile-focus .team-profile-section-kicker{grid-template-columns:2.4rem minmax(0,1fr);}.team-profile-section-kicker h2{margin:0;font-size:clamp(1.65rem,2.4vw,2.45rem);line-height:.98;letter-spacing:-.042em;}.team-profile-section-kicker a{color:inherit;font-size:.62rem;font-weight:820;letter-spacing:.07em;text-decoration:none;text-transform:uppercase;}.team-profile-highlights{display:grid;grid-template-columns:1fr;padding-top:.25rem;}.team-profile-highlights article{position:relative;padding:1.15rem 0;border-bottom:1px solid rgba(9,9,8,.14);}.team-profile-highlights h3{margin:0 0 .9rem;font-family:var(--font-sans);font-size:clamp(1.25rem,1.8vw,1.75rem);line-height:1;letter-spacing:-.035em;font-weight:650;}.team-profile-highlights ul{list-style:none;padding:0;margin:0;display:grid;}.team-profile-highlights li{display:grid;gap:.2rem;padding:.66rem 0;border-top:1px solid rgba(9,9,8,.1);}.team-profile-highlights li strong{font-size:.72rem;}.team-profile-highlights li span{color:#4f4b45;font-size:.78rem;line-height:1.48;}.team-profile-work__rail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;padding-top:1.2rem;}.team-profile-work__rail .project-card__link{position:relative;}.team-profile-work__rail .project-card__media{aspect-ratio:4/3;}.team-profile-work__rail .project-card__body{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:auto auto;gap:.5rem .8rem;padding:.75rem 0 0;}.team-profile-work__rail .project-card__body h3{grid-column:1/-1;grid-row:1;z-index:1;margin:-3.8rem .7rem 1.45rem;color:#fff;font-size:clamp(1.05rem,1.45vw,1.35rem);line-height:1.03;text-shadow:0 1px 1.1rem rgba(0,0,0,.65);}.team-profile-work__rail .project-card__meta{grid-column:1;grid-row:2;}.team-profile-work__rail .project-card__summary{display:none;}.team-profile-work__rail .card-inline-action{grid-column:2;grid-row:2;width:2.25rem;height:2.25rem;min-height:0;display:grid;place-items:center;margin:0;padding:0;border:1px solid rgba(9,9,8,.24);border-radius:50%;font-size:0;}.team-profile-work__rail .card-inline-action i{font-size:.72rem;font-style:normal;}@media(hover:hover) and (pointer:fine){.team-profile-work__rail .project-card{transition:transform .25s ease;}.team-profile-work__rail .project-card:hover{transform:translateY(-3px);}}.team-profile-languages{display:grid;grid-template-columns:8rem 1fr;gap:clamp(2rem,5vw,5rem);align-items:start;padding:1.25rem 0;border-bottom:1px solid rgba(9,9,8,.18);}.team-profile-languages>span{font-size:.62rem;text-transform:uppercase;letter-spacing:.09em;font-weight:850;}.team-profile-languages p{margin:0;font-size:.82rem;}.team-profile-sections{display:grid;}.team-profile-section{display:grid;grid-template-columns:minmax(12rem,.42fr) minmax(0,1fr);gap:clamp(2rem,5vw,5rem);padding-block:clamp(3.6rem,6vw,5.5rem);border-bottom:1px solid rgba(9,9,8,.18);}.team-profile-section__head{display:grid;align-content:start;gap:.6rem;}.team-profile-section__head>span{color:var(--ref-muted);font-size:.61rem;font-weight:850;}.team-profile-section__head h2{margin:0;max-width:12ch;font-family:var(--font-sans);font-size:clamp(1.7rem,2.6vw,2.6rem);line-height:.98;letter-spacing:-.042em;font-weight:660;}.team-profile-section__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1.4rem;border-top:1px solid rgba(9,9,8,.18);}.team-profile-item{min-width:0;padding:1rem 0;border-bottom:1px solid rgba(9,9,8,.14);}.team-profile-item h3{margin:0 0 .25rem;font-family:var(--font-sans);font-size:.88rem;line-height:1.25;font-weight:700;}.team-profile-item p{margin:0;color:#4e4a44;font-size:.78rem;line-height:1.48;}.team-profile-item>span{display:block;margin-top:.35rem;color:var(--ref-muted);font-size:.61rem;text-transform:uppercase;letter-spacing:.06em;}.team-profile-next{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;padding-block:2.2rem 1rem;border-top:1px solid rgba(9,9,8,.18);}.team-profile-next a{min-height:5.4rem;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:auto auto;gap:.45rem 1rem;align-content:center;padding:1rem 1.1rem;color:inherit;background:rgb(245 241 232 / 72%);border:1px solid rgba(9,9,8,.16);border-radius:10px;text-decoration:none;transition:background .25s ease,color .25s ease,transform .25s ease,border-color .25s ease;}.team-profile-next a+a{border-left:1px solid rgba(9,9,8,.16);text-align:right;}.team-profile-next span{grid-column:1/-1;color:var(--ref-muted);font-size:.58rem;font-weight:820;letter-spacing:.08em;text-transform:uppercase;}.team-profile-next strong{font-size:clamp(1.05rem,1.5vw,1.4rem);line-height:1.05;letter-spacing:-.025em;}.team-profile-next a:hover,.team-profile-next a:focus-visible{color:#fff;background:var(--ref-ink);border-color:var(--ref-ink);transform:translateY(-2px);}.team-profile-next a:hover span,.team-profile-next a:focus-visible span{color:rgb(255 255 255 / 64%)}.team-profile-source{display:flex;justify-content:space-between;gap:1rem;padding-block:.85rem 1.7rem;color:var(--ref-muted);font-size:.58rem;text-transform:uppercase;letter-spacing:.07em;}.team-profile-source a{color:inherit;text-decoration:none;}@media(max-width:54rem){.team-profile-hero{grid-template-columns:1fr;align-items:start;}.team-profile-hero::after{right:-10rem;top:58%;width:21rem;}.team-profile-hero__media{width:min(100%,28rem);max-height:none;justify-self:start;}.team-profile-core,.team-profile-languages,.team-profile-section{grid-template-columns:1fr;gap:1.5rem;}.team-profile-core{gap:3.2rem;}}@media(max-width:44rem){.team-profile-page{width:100%;}.team-profile-hero{gap:1.55rem;padding-bottom:2.7rem;}.team-profile-hero h1{font-size:clamp(2.55rem,10.8vw,3.45rem);}.team-profile-role{font-size:.84rem;}.team-profile-intro{margin-top:.7rem;font-size:.98rem;}.team-profile-quote{margin-top:.85rem;}.team-profile-hero__media{width:min(100%,24rem);}.team-profile-core{padding-block:3.5rem;}.team-profile-highlights{grid-template-columns:1fr;}.team-profile-section-kicker{grid-template-columns:2.4rem minmax(0,1fr);}.team-profile-section-kicker a{grid-column:2;justify-self:start;}.team-profile-work__rail{display:grid;grid-auto-flow:column;grid-auto-columns:82%;grid-template-columns:none;gap:.8rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:.4rem;}.team-profile-work__rail::-webkit-scrollbar{display:none}.team-profile-work__rail>*{scroll-snap-align:start}.team-profile-section__grid{grid-template-columns:1fr;}.team-profile-next{grid-template-columns:1fr;gap:.55rem;padding-block:1.6rem .7rem;}.team-profile-next a{min-height:4.8rem;padding:.9rem 1rem;}.team-profile-next a+a{border-left:1px solid rgba(9,9,8,.16);text-align:left;}.team-profile-next strong{font-size:1.05rem;}.team-profile-source{flex-direction:column;gap:.45rem;padding-bottom:1.3rem;}}</style>
