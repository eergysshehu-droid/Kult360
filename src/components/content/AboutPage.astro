---
import {localizedPath, siteConfig, type Language} from '../../lib/site-config';
import {people, personImage, personSlug} from '../../lib/content';

interface Props {language: Language}
const {language} = Astro.props;
const president = people.find((person) => person.role.toLowerCase().includes('president')) || people[0];
const directors = people.filter((person) => person.id !== president?.id);
---
<section class="about-v5 ruled-section">
        <header class="about-v5__hero">
          <p class="about-v5__eyebrow">KULT360 Foundation · Albania</p>
          <div class="about-v5__hero-grid">
            <h1>{language === 'sq' ? 'Rreth KULT360' : 'About KULT360'}</h1>
            <div>
              <p class="about-v5__lead">{language === 'sq' ? 'Kultura si urë. Artistët në qendër.' : 'Culture as a bridge. Artists at the centre.'}</p>
              <p>{language === 'sq'
                ? 'KULT360 është një fondacion i pavarur që lidh kulturën me zhvillimin shoqëror. Ne ndërtojmë ura përmes artit dhe trashëgimisë, duke lidhur talentin vendas, diasporën, komunitetet dhe partnerët ndërkombëtarë.'
                : 'KULT360 is an independent foundation connecting culture with social development. We build bridges through art and heritage, bringing together local talent, the diaspora, communities and international partners.'}</p>
            </div>
          </div>
        </header>
      </section>

      <section class="about-v5__leadership ruled-section">
        <div class="about-v5__section-head">
          <div>
            <p>{language === 'sq' ? 'Udhëheqja' : 'Leadership'}</p>
            <h2>{language === 'sq' ? 'Njerëzit që drejtojnë KULT360.' : 'The people leading KULT360.'}</h2>
          </div>
          <a href={localizedPath('/people/', language)}>{language === 'sq' ? 'Shiko të gjithë ekipin' : 'View all people'} ↗</a>
        </div>

        {president && (
          <a class="about-v5__president" href={localizedPath(`/people/${personSlug(president)}/`, language)}>
            <div class="about-v5__president-media">
              {personImage(president)
                ? <img src={personImage(president)} alt={president.name} loading="lazy" decoding="async" />
                : <span>{president.name.split(' ').map((part) => part[0]).join('').slice(0,2)}</span>}
            </div>
            <div class="about-v5__president-copy">
              <p>{language === 'sq' ? 'Presidenca / Bordi' : 'President / Board'}</p>
              <h3>{president.name}</h3>
              <span>{president.role}</span>
              <i aria-hidden="true">↗</i>
            </div>
          </a>
        )}

        <div class="about-v5__directors-head">
          <p>{language === 'sq' ? 'Drejtuesit' : 'Directors'}</p>
          <span>{language === 'sq' ? 'Drejtimi ekzekutiv dhe programor' : 'Executive and programme leadership'}</span>
        </div>

        <div class="about-v5__director-grid">
          {directors.map((person) => (
            <a href={localizedPath(`/people/${personSlug(person)}/`, language)}>
              <div class="about-v5__director-media">
                {personImage(person)
                  ? <img src={personImage(person)} alt={person.name} loading="lazy" decoding="async" />
                  : <span>{person.name.split(' ').map((part) => part[0]).join('').slice(0,2)}</span>}
              </div>
              <div class="about-v5__director-copy">
                <strong>{person.name}</strong>
                <span>{person.role}</span>
                <i aria-hidden="true">↗</i>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="about-v5__vision ruled-section">
        <p class="about-v5__label">{language === 'sq' ? 'Vizioni ynë' : 'Our vision'}</p>
        <div>
          <blockquote>{language === 'sq'
            ? '“Një peizazh kulturor ku artistët mund të krijojnë me dinjitet, trashëgimia mbetet e gjallë dhe komunitetet marrin pjesë në formësimin e së ardhmes.”'
            : '“A cultural landscape where artists can work with dignity, heritage stays alive and communities take part in shaping the future.”'}</blockquote>
          <p>{language === 'sq'
            ? 'Vizioni ynë është kulturë e gjallë: krijimtari që lëviz mes vendeve dhe brezave, ruan kujtesën, hap dialog dhe krijon lidhje të reja.'
            : 'Our vision is living culture: creative work that moves across places and generations, carries memory, opens dialogue and creates new connections.'}</p>
        </div>
      </section>

      <section class="about-v5__pillars ruled-section">
        <div class="about-v5__section-head">
          <div>
            <p>{language === 'sq' ? 'Shtyllat strategjike' : 'Strategic pillars'}</p>
            <h2>{language === 'sq' ? 'Katër mënyra si e kthejmë misionin në veprim.' : 'Four ways we turn the mission into action.'}</h2>
          </div>
        </div>
        <div class="about-v5__pillar-grid">
          {[
            [language === 'sq' ? 'Mbështetja e artistëve' : 'Supporting Artists', language === 'sq' ? 'Hapësira fizike dhe digjitale për të promovuar dhe shitur drejtpërdrejt punën krijuese.' : 'Physical and digital spaces that promote and bring creative work directly to the public.'],
            [language === 'sq' ? 'Ndryshim shoqëror' : 'Social Change', language === 'sq' ? 'Ndikim në politika përmes aktivizmit kulturor dhe mjedisor.' : 'Driving policy through dedicated cultural and environmental activism.'],
            [language === 'sq' ? 'Hapësira publike' : 'Public Spaces', language === 'sq' ? 'Shndërrimi i vendeve statike në platforma të gjalla për shprehje artistike dhe advokim.' : 'Turning static locations into vibrant platforms for artistic expression and advocacy.'],
            [language === 'sq' ? 'Fuqi ligjore' : 'Legal Power', language === 'sq' ? 'Edukimi mbi të drejtën e autorit dhe pronësinë intelektuale.' : 'Education focused on copyright protection and intellectual property rights.']
          ].map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item[0]}</h3>
              <p>{item[1]}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about-v5__connect">
        <div class="about-v5__connect-intro">
          <p>{language === 'sq' ? 'Lidhu me KULT360' : 'Connect with KULT360'}</p>
          <h2>{language === 'sq' ? 'Bashkëpunim, partneritet apo një bisedë e parë.' : 'Collaborate, partner, or start a conversation.'}</h2>
          <div class="about-v5__connect-actions">
            <a class="pcf-button pcf-button--light" href={localizedPath('/get-involved/', language)}>
              <span>{language === 'sq' ? 'Përfshihu' : 'Get involved'}</span><i aria-hidden="true">↗</i>
            </a>
            <a class="pcf-button pcf-button--ghost" href={localizedPath('/contact/', language)}>
              <span>{language === 'sq' ? 'Faqja e kontaktit' : 'Contact page'}</span><i aria-hidden="true">→</i>
            </a>
          </div>
        </div>

        <div class="about-v5__contact-grid">
          <a href={`mailto:${siteConfig.organization.email}`}>
            <span>{language === 'sq' ? 'Email' : 'Email'}</span>
            <strong>{siteConfig.organization.email}</strong>
            <i aria-hidden="true">↗</i>
          </a>
          <a href={`tel:${siteConfig.organization.phone.replace(/\s+/g,'')}`}>
            <span>{language === 'sq' ? 'Telefon' : 'Phone'}</span>
            <strong>{siteConfig.organization.phone}</strong>
            <i aria-hidden="true">↗</i>
          </a>
          <div>
            <span>{language === 'sq' ? 'Zyra' : 'Office'}</span>
            <strong>{siteConfig.organization.address}</strong>
          </div>
        </div>
      </section>

<style is:global>.about-v5{padding-top:clamp(3.2rem,5vw,5rem);}.about-v5__hero{display:grid;gap:clamp(1.8rem,3.5vw,3.2rem);padding-bottom:clamp(3.3rem,5vw,4.8rem);}.about-v5__eyebrow,.about-v5__label,.about-v5__section-head p,.about-v5__directors-head p,.about-v5__connect-intro>p{margin:0;color:#706b62;font-size:.61rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;}.about-v5__hero-grid{display:grid;grid-template-columns:minmax(12rem,.38fr) minmax(0,1fr);gap:clamp(1.8rem,4.5vw,5.2rem);align-items:start;}.about-v5__hero h1{margin:0;max-width:8ch;font-family:var(--font-sans);font-size:clamp(2.9rem,4.9vw,5rem);font-weight:690;line-height:.9;letter-spacing:-.06em;}.about-v5__hero-grid>div{width:min(100%,46rem);padding-top:.25rem;}.about-v5__lead{margin:0;max-width:18ch;font-family:var(--font-sans);font-size:clamp(1.45rem,2.45vw,2.25rem);font-weight:640;line-height:1.08;letter-spacing:-.035em;}.about-v5__hero-grid>div>p:last-child{margin:1.15rem 0 0;max-width:44rem;color:#4f4a43;font-size:.98rem;line-height:1.68;}.about-v5__leadership{padding-block:clamp(3.5rem,5.6vw,5.4rem);}.about-v5__section-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem 2rem;align-items:end;margin-bottom:1.25rem;}.about-v5__section-head>div{display:grid;gap:.55rem}.about-v5__section-head h2{margin:0;max-width:16ch;font-family:var(--font-sans);font-size:clamp(2rem,3.4vw,3.45rem);line-height:.96;letter-spacing:-.05em;}.about-v5__section-head>a{color:inherit;font-size:.62rem;font-weight:820;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;}.about-v5__president{display:grid;grid-template-columns:minmax(13rem,.36fr) minmax(0,1fr);min-height:20rem;overflow:hidden;color:inherit;background:#ece8df;border:1px solid rgb(9 9 8 / 18%);border-radius:10px;text-decoration:none;}.about-v5__president-media{min-height:20rem;background:#d9d5cc;overflow:hidden;}.about-v5__president-media img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .4s ease;}.about-v5__president:hover .about-v5__president-media img{transform:scale(1.014)}.about-v5__president-media>span{width:100%;height:100%;display:grid;place-items:center;font-size:3.6rem;font-weight:700;}.about-v5__president-copy{position:relative;display:grid;align-content:end;gap:.38rem;padding:clamp(1.2rem,2.5vw,2rem);}.about-v5__president-copy>p{margin:0 0 auto;color:#716c63;font-size:.59rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;}.about-v5__president-copy h3{margin:0;font-family:var(--font-sans);font-size:clamp(2.1rem,3.7vw,3.75rem);line-height:.93;letter-spacing:-.052em;}.about-v5__president-copy>span{max-width:22rem;color:#5f5a53;font-size:.8rem;line-height:1.4;}.about-v5__president-copy i{position:absolute;right:1.1rem;bottom:1.1rem;width:2.35rem;aspect-ratio:1;display:grid;place-items:center;border:1px solid rgb(9 9 8 / 25%);border-radius:50%;font-style:normal;}.about-v5__directors-head{display:flex;justify-content:space-between;gap:1rem;margin-top:2.2rem;padding-bottom:.7rem;border-bottom:1px solid rgb(9 9 8 / 18%);}.about-v5__directors-head span{color:#777168;font-size:.63rem;}.about-v5__director-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;padding-top:.75rem;}.about-v5__director-grid>a{min-width:0;display:grid;gap:.6rem;color:inherit;text-decoration:none;}.about-v5__director-media{aspect-ratio:4/5;overflow:hidden;background:#dedad2;border:1px solid rgb(9 9 8 / 16%);border-radius:8px;}.about-v5__director-media img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .35s ease;}.about-v5__director-grid>a:hover img{transform:scale(1.014)}.about-v5__director-media>span{width:100%;height:100%;display:grid;place-items:center;font-size:2.4rem;font-weight:700;}.about-v5__director-copy{position:relative;display:grid;gap:.18rem;padding-right:1.6rem;}.about-v5__director-copy strong{font-size:.94rem;line-height:1.15;}.about-v5__director-copy span{color:#6c675f;font-size:.64rem;line-height:1.35;}.about-v5__director-copy i{position:absolute;right:0;top:0;font-style:normal;}.about-v5__vision{display:grid;grid-template-columns:7rem minmax(0,1fr);gap:clamp(1.7rem,4vw,4rem);padding-block:clamp(3.6rem,5.5vw,5.5rem);}.about-v5__vision>div{width:min(100%,56rem)}.about-v5__vision blockquote{margin:0;padding-left:1.1rem;border-left:3px solid var(--ref-yellow);font-family:var(--font-sans);font-size:clamp(1.5rem,2.6vw,2.45rem);line-height:1.14;letter-spacing:-.035em;font-weight:610;}.about-v5__vision div>p{margin:1.1rem 0 0;max-width:44rem;color:#4f4a43;font-size:.95rem;line-height:1.66;}.about-v5__pillars{padding-block:clamp(3.5rem,5.5vw,5.4rem);}.about-v5__pillar-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin-top:1.25rem;}.about-v5__pillar-grid article{min-height:13rem;display:grid;grid-template-rows:auto 1fr auto;padding:.9rem;border:1px solid rgb(9 9 8 / 16%);border-radius:8px;background:#eeeae2;}.about-v5__pillar-grid article>span{color:#6b665e;font-size:.58rem;font-weight:850;}.about-v5__pillar-grid h3{align-self:end;margin:0 0 .48rem;font-family:var(--font-sans);font-size:clamp(1.28rem,1.9vw,1.9rem);line-height:.98;letter-spacing:-.035em;}.about-v5__pillar-grid p{margin:0;color:#59554e;font-size:.74rem;line-height:1.48;}.about-v5__pillar-grid article:first-child{border-top:3px solid var(--ref-yellow)}.about-v5__connect{display:grid;grid-template-columns:minmax(0,.88fr) minmax(20rem,1.12fr);gap:clamp(1.8rem,4vw,4.5rem);margin-inline:calc(50% - 50vw);padding-block:clamp(3.5rem,5.5vw,5.3rem);padding-inline:max(1.5rem,calc((100vw - 84rem)/2));color:#fff;background:var(--ref-ink);border-top:4px solid var(--ref-yellow);}.about-v5__connect-intro{display:grid;align-content:start;}.about-v5__connect-intro>p{color:#aaa69d}.about-v5__connect-intro h2{margin:.65rem 0 0;max-width:13ch;color:#fff;font-family:var(--font-sans);font-size:clamp(2rem,3.7vw,3.8rem);line-height:.96;letter-spacing:-.05em;}.about-v5__connect-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.25rem;}.about-v5__contact-grid{display:grid;align-content:start;border-top:1px solid rgb(255 255 255 / 22%);}.about-v5__contact-grid>a,.about-v5__contact-grid>div{position:relative;display:grid;gap:.32rem;padding:.9rem .05rem;color:inherit;border-bottom:1px solid rgb(255 255 255 / 18%);text-decoration:none;}.about-v5__contact-grid span{color:#a9a59d;font-size:.58rem;font-weight:820;letter-spacing:.08em;text-transform:uppercase;}.about-v5__contact-grid strong{max-width:28rem;color:#fff;font-size:clamp(.98rem,1.45vw,1.25rem);font-weight:560;line-height:1.3;}.about-v5__contact-grid i{position:absolute;right:.1rem;top:50%;transform:translateY(-50%);font-style:normal;}@media(max-width:68rem){.about-v5__director-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.about-v5__pillar-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.about-v5__connect{grid-template-columns:1fr}}@media(max-width:54rem){.about-v5__hero-grid,.about-v5__vision{grid-template-columns:1fr;gap:1.15rem;}.about-v5__hero h1{max-width:10ch}}@media(max-width:44rem){.about-v5{padding-top:2.6rem}.about-v5__hero{gap:1.35rem;padding-bottom:2.8rem;}.about-v5__hero h1{max-width:11ch;font-size:clamp(2.45rem,10.4vw,3.25rem);line-height:.93;}.about-v5__lead{max-width:20ch;font-size:clamp(1.3rem,5.8vw,1.7rem);line-height:1.12;}.about-v5__hero-grid>div>p:last-child{margin-top:.9rem;font-size:.91rem;line-height:1.62;}.about-v5__leadership{padding-block:3rem}.about-v5__section-head{grid-template-columns:1fr;gap:.7rem;margin-bottom:1rem;}.about-v5__section-head h2{max-width:17ch;font-size:clamp(1.85rem,8.2vw,2.45rem);line-height:.98;}.about-v5__section-head>a{justify-self:start}.about-v5__president{grid-template-columns:minmax(7.8rem,42%) minmax(0,58%);min-height:12.8rem;}.about-v5__president-media{min-height:12.8rem;aspect-ratio:auto;}.about-v5__president-media img{object-position:center 30%;}.about-v5__president-copy{min-height:0;padding:1rem .85rem;}.about-v5__president-copy>p{margin:0;font-size:.54rem;}.about-v5__president-copy h3{margin-top:auto;font-size:clamp(1.75rem,7.8vw,2.25rem);}.about-v5__president-copy>span{max-width:13rem;padding-right:1.8rem;font-size:.67rem;}.about-v5__president-copy i{right:.75rem;bottom:.75rem;width:2rem;}.about-v5__directors-head{align-items:end;margin-top:1.9rem;}.about-v5__directors-head span{max-width:9rem;text-align:right;font-size:.58rem;line-height:1.35;}.about-v5__director-grid{display:grid;grid-auto-flow:column;grid-auto-columns:47%;grid-template-columns:none;gap:.6rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:.35rem;}.about-v5__director-grid::-webkit-scrollbar{display:none}.about-v5__director-grid>a{scroll-snap-align:start}.about-v5__director-copy strong{font-size:.88rem}.about-v5__director-copy span{font-size:.6rem}.about-v5__vision{padding-block:3.2rem;}.about-v5__vision blockquote{max-width:22ch;font-size:clamp(1.38rem,6.5vw,1.9rem);}.about-v5__vision div>p{font-size:.9rem;line-height:1.6;}.about-v5__pillars{padding-block:3rem}.about-v5__pillar-grid{grid-template-columns:1fr 1fr;gap:.5rem;}.about-v5__pillar-grid article{min-height:10.5rem;padding:.75rem;}.about-v5__pillar-grid h3{font-size:clamp(1.1rem,5.2vw,1.45rem);}.about-v5__pillar-grid p{font-size:.66rem;line-height:1.42;}.about-v5__connect{grid-template-columns:1fr;gap:1.6rem;padding-block:3rem;padding-inline:1.1rem;}.about-v5__connect-intro h2{max-width:15ch;font-size:clamp(1.9rem,8.4vw,2.45rem);line-height:.98;}.about-v5__connect-actions{display:grid;margin-top:1.1rem;}.about-v5__connect-actions .pcf-button{width:100%;min-height:3rem;}.about-v5__contact-grid strong{max-width:18rem;font-size:.98rem;}}</style>
