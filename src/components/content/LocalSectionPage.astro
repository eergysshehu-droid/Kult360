---
import ListingLayout from '../../layouts/ListingLayout.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import JournalCard from './JournalCard.astro';
import PartnerMarquee from './PartnerMarquee.astro';
import {localizedPath, siteConfig, type Language} from '../../lib/site-config';
import {events, formatDate, initiatives, journal, opportunities, people, projectImage, projects, strategicPillars} from '../../lib/content';
import type {ShellPageDefinition} from '../../content/shell-pages';

interface Props {page: ShellPageDefinition; language: Language}
const {page, language} = Astro.props;
const path = localizedPath(`/${page.slug}/`, language);
const t = {
  source: language === 'sq' ? 'Regjistër publik' : 'Public record',
  teamNote: language === 'sq' ? 'Profilet e plota të ekipit janë shtuar nga materiali i dhënë nga KULT360.' : 'Full team profiles have been added from KULT360-supplied source material.',
  archive: language === 'sq' ? 'Përmbajtja e plotë e disa regjistrave mbetet në rishikim editorial.' : 'Full body content for some records remains under editorial review.',
  contact: language === 'sq' ? 'Na kontakto' : 'Contact us'
};
---
<ListingLayout title={page.heading[language]} description={page.description[language]} {language} {path} translations={['en','sq']} about={page.slug === 'about'}>
  <section class="section-intro">
    <SectionHeader eyebrow="KULT360" heading={page.heading[language]} description={page.description[language]} />
  </section>

  {page.slug === 'about' && (
    <>
      <section class="about-v4 ruled-section">
        <div class="about-v4__row">
          <p class="about-v4__label">{language === 'sq' ? 'Rreth nesh' : 'About us'}</p>
          <div>
            <h2>{language === 'sq' ? 'Një fondacion i ndërtuar nga artistët, për artistët.' : 'A Foundation Built by Artists, For Artists.'}</h2>
            <p>{language === 'sq'
              ? 'Fondacioni KULT360 është një organizatë jofitimprurëse e përkushtuar ndaj forcimit të sektorit kulturor. Ne lidhim talentin lokal me skenën ndërkombëtare, fuqizojmë artistët, promovojmë të drejtat dhe përdorim kulturën si mjet për përfshirje demokratike dhe sociale.'
              : 'KULT360 Foundation is a non-profit organization dedicated to strengthening the cultural sector. We bridge local talent with the international arena, empower artists, advance rights, and use culture as a tool for democratic social inclusion.'}</p>
          </div>
        </div>

        <div class="about-v4__row">
          <p class="about-v4__label">{language === 'sq' ? 'Vizioni ynë' : 'Our vision'}</p>
          <div>
            <blockquote>{language === 'sq'
              ? '“Një shoqëri ku arti shërben si instrument kyç për zhvillimin shoqëror dhe fuqizimin e komuniteteve të margjinalizuara.”'
              : '“A society where art serves as the key instrument for social development and the empowerment of marginalized communities.”'}</blockquote>
            <p>{language === 'sq'
              ? 'Ne veprojmë si një urë mes Shqipërisë dhe arenës ndërkombëtare, duke mbështetur krijimtarinë, zanatet dhe artin për një të ardhme të ndërtuar mbi kujtesën kolektive dhe dinjitetin.'
              : 'We act as a bridge between Albania and the international arena, championing creative practice, crafts and art to build a future grounded in collective memory and dignity.'}</p>
          </div>
        </div>

        <div class="about-v4__pillars">
          <div class="about-v4__pillars-head">
            <p class="about-v4__label">{language === 'sq' ? 'Shtyllat strategjike' : 'Strategic pillars'}</p>
            <h2>{language === 'sq' ? 'Ndikojmë jetën shoqërore përmes katër veprimeve kryesore.' : 'Influencing social life through four key actions.'}</h2>
          </div>
          <div class="about-v4__pillar-grid">
            {[
              [language === 'sq' ? 'Mbështetja e artistëve' : 'Supporting Artists', language === 'sq' ? 'Hapësira fizike dhe digjitale për të promovuar dhe shitur drejtpërdrejt punën krijuese.' : 'Physical and digital spaces that promote and bring creative work directly to the public.'],
              [language === 'sq' ? 'Ndryshim shoqëror' : 'Social Change', language === 'sq' ? 'Ndikim në politika përmes aktivizmit kulturor dhe mjedisor.' : 'Driving policy through dedicated cultural and environmental activism.'],
              [language === 'sq' ? 'Hapësira publike' : 'Public Spaces', language === 'sq' ? 'Shndërrimi i vendeve statike në platforma të gjalla për shprehje artistike dhe advokim.' : 'Turning static locations into vibrant platforms for artistic expression and advocacy.'],
              [language === 'sq' ? 'Fuqi ligjore' : 'Legal Power', language === 'sq' ? 'Edukimi mbi të drejtën e autorit dhe pronësinë intelektuale.' : 'Education focused on copyright protection and intellectual property rights.']
            ].map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{item[0]}</h3>
                <p>{item[1]}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ruled-section">
        <div class="section-kicker"><span>01</span><h2>{language === 'sq' ? 'Ekipi' : 'Team'}</h2></div>
        <div class="people-list">
          {people.map((person) => (
            <a class="person-row" href={localizedPath(`/people/${person.id.replace(/^person-/, '')}/`, language)}>
              <span>{person.name}</span><span>{person.role}</span><span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="source-note">{t.teamNote}</p>
      </section>
    </>
  )}

  {page.slug === 'programs' && (
    <>
      <section class="program-page-grid ruled-section">
        {strategicPillars.map((item, index) => (
          <article class="program-page-card">
            <span class="program-page-card__index">0{index + 1}</span>
            <h2>{item.title}</h2>
            <p>{item.summary || (language === 'sq' ? 'Fushë strategjike e KULT360.' : 'KULT360 strategic focus area.')}</p>
            <span class="program-page-card__accent" aria-hidden="true"></span>
          </article>
        ))}
      </section>
      <section class="ruled-section">
        <div class="section-kicker"><span>+</span><h2>{language === 'sq' ? 'Nisma' : 'Initiatives'}</h2></div>
        <div class="two-column-list">{initiatives.map((item) => <article><h3>{item.title}</h3><p>{item.summary}</p></article>)}</div>
      </section>
    </>
  )}

  {page.slug === 'projects' && <section class="project-grid ruled-section">{projects.map((project) => <ProjectCard {project} {language} />)}</section>}

  {page.slug === 'events' && (
    <section class="event-list ruled-section">
      {events.map((event) => <article><div><p class="meta">{formatDate(event.start, language)}</p><h2>{event.title}</h2></div><p>{event.location || '—'}</p></article>)}
    </section>
  )}

  {page.slug === 'journal' && (
    <section class="journal-index ruled-section">
      {journal.map((record) => <JournalCard {record} {language} />)}
    </section>
  )}

  {page.slug === 'media' && (
    <section class="media-grid ruled-section">
      {projects.filter((item) => item.id.startsWith('project-')).map((project) => {
        const asset = projectImage(project);
        return asset && <figure><img src={asset} alt="" loading="lazy" decoding="async" /><figcaption>{project.title}</figcaption></figure>;
      })}
    </section>
  )}

  {page.slug === 'people' && (
    <section class="people-grid ruled-section">{people.map((person) => <article><p class="meta">{person.role}</p><h2><a href={localizedPath(`/people/${person.id.replace(/^person-/, '')}/`, language)}>{person.name}</a></h2></article>)}</section>
  )}

  {(page.slug === 'opportunities' || page.slug === 'get-involved' || page.slug === 'support') && (
    <section class="opportunity-grid ruled-section">{opportunities.map((item) => <article><p class="meta">{item.kind}</p><h2>{item.title}</h2>{item.summary && <p>{item.summary}</p>}</article>)}</section>
  )}

  {page.slug === 'lab' && <section class="empty-record ruled-section"><p class="display-copy">KULT360 LAB</p><p>{t.archive}</p></section>}
  {page.slug === 'resources' && <section class="empty-record ruled-section"><p>{t.archive}</p></section>}

  {page.slug === 'contact' && (
    <section class="contact-grid ruled-section">
      <div><p class="meta">{t.contact}</p><h2><a href={`mailto:${siteConfig.organization.email}`}>{siteConfig.organization.email}</a></h2><p><a href={`tel:${siteConfig.organization.phone?.replace(/\s/g,'')}`}>{siteConfig.organization.phone}</a></p></div>
      <div><p>{siteConfig.organization.address}</p><p><a href={siteConfig.social.instagram}>Instagram</a> · <a href={siteConfig.social.facebook}>Facebook</a> · <a href={siteConfig.social.youtube}>YouTube</a></p></div>
    </section>
  )}

  {page.slug !== 'contact' && page.slug !== 'media' && (
    <section class="partner-strip partner-strip--logos ruled-section">
      <div class="partner-strip__head">
        <p class="meta">{language === 'sq' ? 'Partnerë & bashkëpunëtorë' : 'Partners & collaborators'}</p>
        <p>{language === 'sq' ? 'Rrjeti historik i partnerëve dhe bashkëpunëtorëve KULT360.' : 'KULT360’s historic network of partners and collaborators.'}</p>
      </div>
      <PartnerMarquee {language} />
    </section>
  )}
</ListingLayout>
