---
import {shellPages} from '../../content/shell-pages';
import {localizedPath, type Language} from '../../lib/site-config';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props {language: Language; path: string; translations: readonly Language[]}
const {language, path, translations} = Astro.props;
const navSlugs = ['about','programs','projects','journal','media','get-involved'];
const items = shellPages.filter(({slug}) => navSlugs.includes(slug));
---
<div class="mobile-navigation" data-mobile-nav>
  <button class="menu-trigger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" aria-expanded="false"><span>{language === 'sq' ? 'Menu' : 'Menu'}</span><span aria-hidden="true">☰</span></button>
  <dialog class="menu-dialog" id="mobile-menu" aria-labelledby="mobile-menu-title">
    <div class="menu-dialog__panel">
      <div class="menu-dialog__header"><p class="wordmark" id="mobile-menu-title">KULT<span class="wordmark__360">360</span></p><button class="menu-close" type="button" aria-label={language === 'sq' ? 'Mbyll menunë' : 'Close menu'}>×</button></div>
      <nav aria-label={language === 'sq' ? 'Navigimi kryesor' : 'Primary navigation'}><ul class="menu-list">{items.map((item, index) => <li><span>0{index + 1}</span><a href={localizedPath(`/${item.slug}/`, language)}>{item.label[language]}</a></li>)}</ul></nav>
      <div class="menu-dialog__foot"><LanguageSwitcher {language} {path} {translations} /><a href="mailto:office@kult360.com">office@kult360.com</a></div>
    </div>
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-mobile-nav]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.menu-trigger');
    const closeButton = root.querySelector<HTMLButtonElement>('.menu-close');
    const dialog = root.querySelector<HTMLDialogElement>('.menu-dialog');
    if (!trigger || !closeButton || !dialog) return;
    const close = () => dialog.close();
    trigger.addEventListener('click', () => {dialog.showModal();trigger.setAttribute('aria-expanded','true');document.documentElement.classList.add('menu-open');closeButton.focus();});
    closeButton.addEventListener('click', close);
    dialog.addEventListener('click', (event) => {if (event.target === dialog) close();});
    dialog.addEventListener('close', () => {trigger.setAttribute('aria-expanded','false');document.documentElement.classList.remove('menu-open');trigger.focus();});
    dialog.addEventListener('cancel', () => close());
  });
</script>
