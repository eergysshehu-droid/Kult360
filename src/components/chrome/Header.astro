---
import {shellPages} from '../../content/shell-pages';
import {localizedPath, type Language} from '../../lib/site-config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {language: Language; path: string; translations: readonly Language[]}
const {language, path, translations} = Astro.props;
const navSlugs = ['about','programs','projects','journal','get-involved'];
const items = shellPages.filter(({slug}) => navSlugs.includes(slug));
const normalizedPath = path.replace(/^\/sq\/?/, '/');
const activeSlug = normalizedPath.split('/').filter(Boolean)[0] ?? '';
---
<header class="site-header">
  <div class="container-wide site-header__inner">
    <a class="brand-lockup" href={localizedPath('/', language)} aria-label={language === 'sq' ? 'KULT360, kreu' : 'KULT360, home'}>
      <span class="brand-lockup__mark" aria-hidden="true">
        <img class="brand-lockup__base" src="/media/brand/kult360-logo.png" alt="" />
        <img class="brand-lockup__accent" src="/media/brand/kult360-logo.png" alt="" />
      </span>
</a>
    <nav class="desktop-navigation" aria-label={language === 'sq' ? 'Navigimi kryesor' : 'Primary navigation'}>
      <ul>{items.map((item) => <li><a href={localizedPath('/' + item.slug + '/', language)} aria-current={activeSlug === item.slug ? 'page' : undefined}>{item.label[language]}</a></li>)}</ul>
    </nav>
    <div class="desktop-language"><LanguageSwitcher {language} {path} {translations} /></div>
    <MobileNavigation {language} {path} {translations} />
  </div>
  <span class="site-progress" data-page-progress aria-hidden="true"></span>
</header>
