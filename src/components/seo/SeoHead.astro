---
import {absoluteUrl, localizedPath, siteConfig, type Language} from '../../lib/site-config';

interface Props {
  title: string;
  description: string;
  path: string;
  language: Language;
  translations?: readonly Language[];
  image?: string;
  noindex?: boolean;
}

const {title, description, path, language, translations = [language], image, noindex = false} = Astro.props;
const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = absoluteUrl(path);
const alternates = translations.map((item) => ({
  language: item,
  href: absoluteUrl(localizedPath(path.replace(/^\/sq\/?/, '/'), item))
}));
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
{alternates.map(({language: alternateLanguage, href}) => (
  <link rel="alternate" hreflang={alternateLanguage} href={href} />
))}
{translations.includes('en') && <link rel="alternate" hreflang="x-default" href={absoluteUrl(path.replace(/^\/sq\/?/, '/'))} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={language === 'sq' ? 'sq_AL' : 'en_US'} />
{image && <meta property="og:image" content={absoluteUrl(image)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
