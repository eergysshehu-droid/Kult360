---
interface Props {eyebrow?: string; heading: string; description?: string}
const {eyebrow, heading, description} = Astro.props;
---
<header class="section-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{heading}</h1>
  {description && <p class="section-header__description">{description}</p>}
</header>
